# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Output files (keep directory, ignore contents except .gitkeep)
output/*.pdf
!output/.gitkeep

# Generated PDF reports
*.pdf
!examples/*.pdf

# Client data files (protect real client information)
data/*
!data/.gitkeep
!data/sample_*.csv
!data/client_portfolio.csv
!data/input/
!data/output/
data/output/*.html

# Real client data — NEVER commit these
data/clients/*
!data/clients/.gitkeep

# Anonymized data — safe to commit for testing
!data/anonymized/

# Name-mapping files (link anonymous IDs back to real names)
_name_mapping.json
